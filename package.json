{
  "name": "@itslil/monaco-editor",
  "version": "0.56.1",
  "description": "monaco-editor 0.56.0 reimplemented in LilScript. Independent editor runtime plus the official Microsoft TypeScript worker. Not 100% feature parity.",
  "keywords": [
    "monaco",
    "monaco-editor",
    "editor",
    "lilscript",
    "itslil"
  ],
  "homepage": "https://yeargun.github.io/monacolil/",
  "bugs": "https://github.com/yeargun/monacolil/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/monacolil.git"
  },
  "license": "MIT",
  "author": "yeargun",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/monaco.cjs",
  "module": "./dist/monaco.esm.js",
  "types": "./types/monaco.d.ts",
  "unpkg": "./dist/monaco.esm.js",
  "jsdelivr": "./dist/monaco.esm.js",
  "exports": {
    ".": {
      "types": "./types/monaco.d.ts",
      "import": "./dist/monaco.esm.js",
      "require": "./dist/monaco.cjs",
      "default": "./dist/monaco.esm.js"
    },
    "./monaco.css": "./dist/monaco.css",
    "./workers/*": "./dist/workers/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/monaco.esm.js",
    "dist/monaco.cjs",
    "dist/monaco.css",
    "dist/workers",
    "types/monaco.d.ts",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "sideEffects": [
    "./dist/monaco.esm.js",
    "./dist/monaco.cjs",
    "./dist/monaco.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:site": "node scripts/write-results.mjs && node scripts/build-site.mjs",
    "check:site": "npm run build:site && node --test test/site.test.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "prepublishOnly": "npm run check:pack && npm run check:site"
  },
  "devDependencies": {
    "esbuild": "^0.25.8",
    "monaco-editor": "0.56.0"
  }
}
